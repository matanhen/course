{
  "name": "Weekly Student Data Webhook",
  "description": "Sends per-student data (name, email, registration date, first/last login, lessons watched) for the \"\u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05de\u05ea\u05e2\u05e9\u05e8\u05d9\u05dd - \u05dc\u05d9\u05d5\u05d5\u05d9 \u05d0\u05d9\u05e9\u05d9 \u05e4\u05e8\u05d9\u05de\u05d9\u05d5\u05dd\" course to the Make.com webhook, every Sunday at 9:00 Israel time.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * 0",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_student_data_webhook",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWeeklyStudentDataToWebhook",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendWeeklyStudentDataToWebhook"
  }
}